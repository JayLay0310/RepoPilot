# RepoPilot 环境变量配置示例

# 应用配置
REPOPILOT_APP_NAME=RepoPilot
REPOPILOT_APP_ENV=dev
REPOPILOT_HOST=0.0.0.0
REPOPILOT_PORT=8000

# OpenAI 配置
REPOPILOT_OPENAI_API_KEY=sk-xxx
REPOPILOT_OPENAI_MODEL=gpt-4-turbo
REPOPILOT_LLM_TEMPERATURE=0.7
REPOPILOT_LLM_MAX_TOKENS=2000

# 向量模型配置
REPOPILOT_EMBEDDING_MODEL=sentence-transformers/multilingual-e5-large
REPOPILOT_VECTOR_STORE_DIR=.faiss
REPOPILOT_EMBEDDING_CACHE_PATH=.cache/embeddings.json

# 检索配置
REPOPILOT_RETRIEVAL_TOP_K=10
REPOPILOT_RETRIEVAL_ALPHA=0.5
REPOPILOT_SIMILARITY_THRESHOLD=0.5

# CORS 配置
REPOPILOT_CORS_ORIGINS=http://localhost,http://127.0.0.1
